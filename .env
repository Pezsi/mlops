# MLOps Pipeline Environment Configuration
# Basic configuration for running Airflow and services

# ============ Email Notification Settings ============
# Dummy values - not configured for actual email sending
SMTP_USER=demo@example.com
SMTP_PASSWORD=demo-password-not-configured
TO_EMAILS=admin@example.com

# ============ Slack Notification Settings ============
# Dummy value - not configured for actual Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/DUMMY/WEBHOOK/URL

# ============ Webhook API Settings ============
# API key for securing webhook trigger endpoints
WEBHOOK_API_KEY=mlops-secret-key-2025

# ============ Flask Debug Mode ============
# Set to "false" for demo/production
FLASK_DEBUG=false
